# Postgres (docker compose up -d db)
DATABASE_URL=postgres://ic:ic@localhost:5432/ic

# Vision model provider: fake | anthropic | openai-compatible
VISION_PROVIDER=fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Azure OpenAI or any OpenAI-compatible server (Ollama, vLLM)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
# Samples per image for self-consistency (1 = off)
VISION_SAMPLES=3

# Auth: none | entra
AUTH_MODE=none
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=

# Where uploaded images live (local disk; swap for Azure Blob in production)
IMAGE_DIR=./data/uploads
